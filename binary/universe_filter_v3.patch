 // exceeded early. This is only best-effort, since specificity means that many matched methods
 // may be sorted and removed in the output processing for ml_matches and therefore we can only
 // conservatively under-approximate the matches during the search.
+// --- trait-universe filter (trait-bound PoC) --------------------------------
+// When set (a Vector{Any} of Modules), jl_matching_methods/ml_matches resolve
+// ONLY into methods whose defining module chain intersects the universe —
+// sealed resolution below the matcher: specificity and shadowing are computed
+// as if outside methods did not exist. NULL disables. The caller (Julia side)
+// must keep the array rooted. PoC scope: inference/reflection-time matching;
+// runtime dispatch caches are not filtered.
+static _Atomic(jl_array_t*) jl_universe_modules;
+
+// P2 (PoC): direct-mapped cache for sealed dynamic dispatch, so sealed
+// frames are not uncached-per-call. Keyed on the (interned) concrete arg
+// tuple type; world-bounded; flushed whenever the universe changes. Because
+// the filtered matcher does not narrow validity for skipped outside methods,
+// entries stay valid across pirate definitions (sealed immortality).
+#define JL_SEALED_CACHE_LEN 1024
+static _Atomic(jl_array_t*) jl_sealed_dispatch_cache;
+static size_t jl_sealed_cache_minw[JL_SEALED_CACHE_LEN];
+static size_t jl_sealed_cache_maxw[JL_SEALED_CACHE_LEN];
+
+JL_DLLEXPORT void jl_set_universe_filter(jl_array_t *mods)
+{
+    jl_array_t *scache = jl_atomic_load_relaxed(&jl_sealed_dispatch_cache);
+    if (scache != NULL) {   // universe changed: flush sealed dispatch cache
+        for (size_t i = 0; i < 2 * JL_SEALED_CACHE_LEN; i++)
+            jl_array_ptr_set(scache, i, NULL);
+    }
+    jl_atomic_store_release(&jl_universe_modules, mods);
+}
+
+static int jl_universe_filter_active(void) JL_NOTSAFEPOINT
+{
+    return jl_atomic_load_relaxed(&jl_universe_modules) != NULL;
+}
+
+static int jl_universe_allows(jl_method_t *meth) JL_NOTSAFEPOINT
+{
+    jl_array_t *mods = jl_atomic_load_relaxed(&jl_universe_modules);
+    if (mods == NULL)
+        return 1;
+    jl_module_t *m = meth->module;
+    while (1) {
+        for (size_t i = 0; i < jl_array_nrows(mods); i++) {
+            if (jl_array_ptr_ref(mods, i) == (jl_value_t*)m)
+                return 1;
+        }
+        if (m->parent == m || m->parent == NULL)
+            return 0;
+        m = m->parent;
+    }
+}
+// P1b: task/thread-scoped sealed dispatch. `jl_set_sealed_mode(1)` makes
+// every dynamic call in this dynamic extent resolve through the filtered
+// matcher (uncached — universe-keyed caches are P2 work). Returns the old
+// value so callers can save/restore. Scope caveat (PoC): thread-local, so
+// a sealed frame must not migrate threads mid-flight.
+JL_DLLEXPORT int8_t jl_set_sealed_mode(int8_t on)
+{
+    jl_ptls_t ptls = jl_current_task->ptls;
+    int8_t old = ptls->sealed_mode;
+    ptls->sealed_mode = on;
+    return old;
+}
+
+static int jl_sealed_dispatch_active(void) JL_NOTSAFEPOINT
+{
+    return jl_atomic_load_relaxed(&jl_universe_modules) != NULL &&
+           jl_current_task->ptls->sealed_mode;
+}
